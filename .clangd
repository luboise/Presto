CompileFlags:
  # Add: [-Wall, -Werror]
  Add: [-Wall, -Werror, -std=c++20]
  Remove: [-fmodules-ts, -fdeps-format=p1689r5, -fmodule-mapper=*] # Prevents preloading PCH in clangd diagnostics

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - bugprone*
      - concurrency*
      - cppcoreguidelines*
      - cppcoreguidelines-naming-*
      - modernize*
      - performance*
      - readability*
      - hicpp*
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - cppcoreguidelines-avoid-magic-numbers
      - cppcoreguidelines-pro-type-union-access
      - readability-magic-numbers
      - bugprone-easily-swappable-parameters
